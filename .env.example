# Copy this file to .env and fill in your own credentials.
#   cp .env.example .env
#
# Wrap values in single quotes if they contain special characters.

# ─── StatsBomb API ───────────────────────────────────────────────────────────
STATSBOMB_USERNAME='your_statsbomb_email'
STATSBOMB_PASSWORD='your_statsbomb_password'

# ─── SkillCorner API ─────────────────────────────────────────────────────────
SKILLCORNER_USERNAME='your_skillcorner_login'
SKILLCORNER_PASSWORD='your_skillcorner_password'

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Running locally: DB_HOST=localhost
# Running through docker-compose: DB_HOST=db  (leave the rest as-is)
DB_HOST=db
DB_PORT=5432
DB_NAME=fc_metz_mini_projet
DB_USER=postgres
DB_PASSWORD=postgres
